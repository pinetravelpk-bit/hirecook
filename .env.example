# Phone, WhatsApp, email, address, hours, analytics and the footer credit are managed in
# Admin → Settings (stored in the database). Nothing to set here for those.

# First admin account (created automatically on first start if no users exist).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Optional: fixed secret for signing admin sessions (otherwise generated and stored in the DB).
ADMIN_SECRET=

# Where the SQLite database (leads, clients, cooks, settings) is stored.
LEADS_DIR=/var/lib/hirecook

# Optional lead notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEADS_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
